{
  "name": "omnicontent",
  "version": "1.0.0",
  "description": "AI Multi-Channel Content Repurposing Suite",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\" --names \"server,client\" --prefix-colors \"cyan,magenta\"",
    "start:server": "node server/index.js",
    "start:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
